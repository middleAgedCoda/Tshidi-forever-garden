<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Tshidi's Forever Garden 🌙</title>
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="data:application/json;base64,">
    
    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js')
                .then(() => console.log('SW Registered'))
                .catch(() => console.log('SW failed'));
        }
    </script>

    <style>
        /* ============================================
           PREMIUM DARK ROMANTIC THEME
           ============================================ */
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;600;700&display=swap');

        :root {
            --primary: #FF1493;
            --primary-glow: #FF1493;
            --secondary: #9400D3;
            --accent: #FFD700;
            --bg-primary: #0a0a0f;
            --bg-secondary: #1a0a1e;
            --bg-card: rgba(26, 10, 30, 0.85);
            --text-primary: #f0e6ff;
            --text-secondary: #b8a0c8;
            --border-glow: rgba(255, 20, 147, 0.3);
            --shadow-glow: 0 0 40px rgba(255, 20, 147, 0.15);
            --radius: 24px;
            --font-display: 'Cinzel', serif;
            --font-body: 'Inter', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            -webkit-tap-highlight-color: transparent;
        }

        /* Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* Loading Screen */
        #loading {
            position: fixed;
            inset: 0;
            background: var(--bg-primary);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 1.2s ease, visibility 1.2s ease;
        }
        #loading.hidden { opacity: 0; visibility: hidden; }

        .loader-ring {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 3px solid transparent;
            border-top-color: var(--primary);
            border-right-color: var(--secondary);
            animation: spin 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
            position: relative;
            margin: 0 auto 30px;
        }
        .loader-ring::before {
            content: '💗';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2.5rem;
            animation: pulse-glow 1.5s ease-in-out infinite;
        }
        .loader-ring::after {
            content: '';
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            border: 2px solid transparent;
            border-bottom-color: var(--accent);
            animation: spin 2s cubic-bezier(0.65, 0, 0.35, 1) infinite reverse;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes pulse-glow {
            0%, 100% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.2); }
        }

        .loader-text {
            font-family: var(--font-display);
            font-size: 1.2rem;
            color: var(--text-secondary);
            letter-spacing: 4px;
            animation: fade-text 1.5s ease-in-out infinite;
        }
        .loader-text span { color: var(--primary); font-weight: 700; }
        @keyframes fade-text {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }

        /* Main App */
        #app {
            position: relative;
            z-index: 1;
            max-width: 480px;
            margin: 0 auto;
            padding: 0 16px 100px 16px;
        }

        /* Header */
        header {
            position: relative;
            background: linear-gradient(135deg, rgba(255,20,147,0.15), rgba(148,0,211,0.15));
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-glow);
            padding: 20px 24px;
            border-radius: 0 0 var(--radius) var(--radius);
            margin: 0 -16px 24px -16px;
            box-shadow: var(--shadow-glow), inset 0 1px 0 rgba(255,255,255,0.05);
            overflow: hidden;
        }
        header::before {
            content: '';
            position: absolute;
            inset: -50%;
            background: radial-gradient(circle at 30% 50%, rgba(255,20,147,0.05), transparent 70%);
            animation: header-shimmer 8s ease-in-out infinite;
        }
        @keyframes header-shimmer {
            0%, 100% { transform: translateX(-10%) rotate(0deg); }
            50% { transform: translateX(10%) rotate(5deg); }
        }

        .header-content {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header h1 {
            font-family: var(--font-display);
            font-size: 1.1rem;
            font-weight: 700;
            background: linear-gradient(135deg, #FF1493, #FFD700, #9400D3);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 1px;
            cursor: pointer;
        }
        header h1::before { content: '🌙 '; -webkit-text-fill-color: initial; }

        .header-stats {
            display: flex;
            gap: 12px;
            font-size: 0.8rem;
        }
        .header-stats span {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.05);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .header-stats span::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            animation: dot-pulse 2s ease-in-out infinite;
        }
        #love-streak::before { background: var(--primary); }
        #total-score::before { background: var(--accent); }
        @keyframes dot-pulse {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.3); }
        }

        /* Install Button */
        #install-btn {
            display: none;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        #install-btn:hover {
            background: rgba(255,20,147,0.2);
            border-color: var(--primary);
        }

        /* Navigation */
        .main-nav {
            display: flex;
            gap: 6px;
            padding: 6px;
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 30px;
            margin-bottom: 24px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.3);
            overflow-x: auto;
        }
        .nav-btn {
            flex: 1;
            padding: 10px 8px;
            border: none;
            background: transparent;
            border-radius: 25px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            white-space: nowrap;
            min-width: fit-content;
        }
        .nav-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 25px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .nav-btn.active {
            color: white;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            box-shadow: 0 4px 20px rgba(255,20,147,0.3);
            transform: scale(1.02);
        }
        .nav-btn:active { transform: scale(0.95); }

        /* Pages */
        .page {
            display: none;
            animation: page-enter 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .page.active { display: block; }
        @keyframes page-enter {
            from { opacity: 0; transform: translateY(20px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Cards */
        .card {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: var(--radius);
            padding: 24px;
            box-shadow: var(--shadow-glow), inset 0 1px 0 rgba(255,255,255,0.03);
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary), var(--secondary), transparent);
            opacity: 0.3;
        }

        /* Buttons */
        .btn-primary, .btn-secondary, .btn-adult {
            padding: 14px 28px;
            border: none;
            border-radius: 30px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
            margin-top: 12px;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            box-shadow: 0 4px 30px rgba(255,20,147,0.3);
        }
        .btn-primary:active { transform: scale(0.97); }
        .btn-secondary {
            background: rgba(255,255,255,0.05);
            color: var(--text-primary);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .btn-secondary:hover {
            background: rgba(255,255,255,0.1);
            border-color: var(--primary);
        }
        .btn-secondary:active { transform: scale(0.97); }
        .btn-adult {
            background: linear-gradient(135deg, #FF0000, #8B0000);
            color: white;
            box-shadow: 0 4px 30px rgba(255,0,0,0.3);
            font-family: var(--font-display);
            letter-spacing: 2px;
        }
        .btn-adult:active { transform: scale(0.97); }

        /* Adult Mode Lock */
        .adult-lock {
            position: relative;
            overflow: hidden;
        }
        .adult-lock::after {
            content: '🔞';
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 2rem;
            opacity: 0.3;
        }

        /* Home */
        .greeting h2 {
            font-family: var(--font-display);
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #FF1493, #FFD700);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }
        .love-message {
            color: var(--text-secondary);
            font-style: italic;
            font-size: 0.95rem;
            opacity: 0.8;
            border-left: 2px solid var(--primary);
            padding-left: 16px;
            margin-bottom: 20px;
        }

        /* Word Game */
        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .game-header h2 {
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .level-badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 4px 16px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            color: white;
            letter-spacing: 1px;
            box-shadow: 0 2px 15px rgba(255,20,147,0.2);
        }
        .level-progress {
            font-size: 0.7rem;
            color: var(--text-secondary);
            text-align: center;
            margin-top: 4px;
        }
        .level-progress .bar {
            display: block;
            height: 4px;
            background: rgba(255,255,255,0.05);
            border-radius: 4px;
            margin-top: 4px;
            overflow: hidden;
        }
        .level-progress .bar .fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 4px;
            transition: width 0.5s ease;
            width: 0%;
        }

        .word-display {
            text-align: center;
            padding: 30px 0;
            position: relative;
        }
        .word-display::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 20%;
            right: 20%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--primary), transparent);
        }
        .scrambled-word {
            font-family: var(--font-display);
            font-size: 2.8rem;
            font-weight: 900;
            letter-spacing: 8px;
            background: linear-gradient(135deg, #FF1493, #FFD700);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
            text-shadow: 0 0 60px rgba(255,20,147,0.2);
        }
        .hint {
            color: var(--text-secondary);
            font-size: 0.9rem;
            opacity: 0.7;
        }

        .word-input-area, .logic-input {
            display: flex;
            gap: 12px;
            margin: 20px 0;
        }
        .word-input-area input, .logic-input input {
            flex: 1;
            padding: 14px 18px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            color: var(--text-primary);
            font-size: 1rem;
            transition: all 0.3s ease;
            outline: none;
        }
        .word-input-area input:focus, .logic-input input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 30px rgba(255,20,147,0.1);
            background: rgba(255,255,255,0.05);
        }
        .word-input-area input::placeholder, .logic-input input::placeholder {
            color: var(--text-secondary);
            opacity: 0.5;
        }
        .word-input-area button, .logic-input button {
            padding: 14px 24px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            border-radius: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }
        .word-input-area button:active, .logic-input button:active {
            transform: scale(0.95);
        }

        .word-feedback {
            text-align: center;
            min-height: 50px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px;
            border-radius: 12px;
            font-size: 1.1rem;
        }
        .word-feedback.success {
            color: #4CAF50;
            background: rgba(76,175,80,0.1);
            border: 1px solid rgba(76,175,80,0.2);
        }
        .word-feedback.error {
            color: #FF6B6B;
            background: rgba(255,107,107,0.1);
            border: 1px solid rgba(255,107,107,0.2);
        }
        .word-feedback.adult {
            color: #FF1493;
            background: rgba(255,20,147,0.1);
            border: 1px solid rgba(255,20,147,0.2);
        }

        .word-stats {
            display: flex;
            justify-content: space-around;
            padding: 14px;
            background: rgba(255,255,255,0.02);
            border-radius: 16px;
            margin: 12px 0;
            border: 1px solid rgba(255,255,255,0.03);
        }
        .word-stats span {
            font-weight: 600;
            color: var(--text-secondary);
        }
        .word-stats span strong { color: var(--text-primary); }

        /* Sudoku */
        .sudoku-board {
            display: grid;
            grid-template-columns: repeat(9, 1fr);
            gap: 1px;
            max-width: 400px;
            margin: 0 auto;
            background: rgba(255,255,255,0.05);
            padding: 4px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .sudoku-cell {
            aspect-ratio: 1;
            background: rgba(255,255,255,0.02);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            border-radius: 2px;
            color: var(--text-primary);
        }
        .sudoku-cell.given {
            background: rgba(255,255,255,0.05);
            color: var(--text-secondary);
        }
        .sudoku-cell.selected {
            background: rgba(255,20,147,0.15);
            box-shadow: inset 0 0 20px rgba(255,20,147,0.1);
        }
        .sudoku-cell.user-filled { color: var(--primary); }
        .sudoku-cell.correct {
            background: rgba(76,175,80,0.2);
            animation: correct-flash 0.5s ease;
        }
        .sudoku-cell.wrong {
            background: rgba(255,107,107,0.2);
            animation: wrong-shake 0.5s ease;
        }
        @keyframes correct-flash {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); background: rgba(76,175,80,0.4); }
        }
        @keyframes wrong-shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .number-pad {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin: 16px 0;
        }
        .number-pad button {
            padding: 12px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .number-pad button:active {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            transform: scale(0.95);
            border-color: var(--primary);
        }

        .game-instructions {
            background: rgba(255,255,255,0.02);
            padding: 12px 16px;
            border-radius: 12px;
            margin: 12px 0;
            border: 1px solid rgba(255,255,255,0.03);
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }
        .game-instructions strong {
            color: var(--text-primary);
        }

        /* Logic */
        .logic-puzzle {
            padding: 30px 20px;
            background: rgba(255,255,255,0.02);
            border-radius: 16px;
            margin: 16px 0;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            line-height: 1.8;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.03);
        }
        .logic-stats {
            text-align: center;
            padding: 14px;
            background: rgba(255,255,255,0.02);
            border-radius: 16px;
            margin: 12px 0;
            border: 1px solid rgba(255,255,255,0.03);
        }

        /* Garden */
        .garden-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            padding: 20px 0;
            min-height: 200px;
        }
        .garden-flower {
            font-size: 2.8rem;
            text-align: center;
            animation: bloom 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            transition: all 0.3s ease;
            cursor: default;
        }
        .garden-flower:hover { transform: scale(1.2) rotate(10deg); }
        @keyframes bloom {
            0% { transform: scale(0) rotate(-180deg); opacity: 0; }
            60% { transform: scale(1.2) rotate(10deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }

        .garden-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 20px 0;
        }
        .stat-item {
            background: rgba(255,255,255,0.02);
            padding: 16px;
            border-radius: 16px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.03);
            transition: all 0.3s ease;
        }
        .stat-item:hover { border-color: rgba(255,20,147,0.1); }
        .stat-icon { font-size: 2rem; display: block; margin-bottom: 4px; }
        .stat-item span:not(.stat-icon) { display: block; font-weight: 700; }
        .stat-item .stat-value {
            font-size: 1.5rem;
            font-family: var(--font-display);
            color: var(--primary);
        }

        .love-letter {
            background: linear-gradient(135deg, rgba(255,20,147,0.05), rgba(148,0,211,0.05));
            padding: 20px;
            border-radius: 16px;
            margin-top: 20px;
            border: 1px solid rgba(255,20,147,0.1);
            position: relative;
            overflow: hidden;
        }
        .love-letter::before {
            content: '💕';
            position: absolute;
            right: -10px;
            bottom: -10px;
            font-size: 4rem;
            opacity: 0.05;
        }
        .love-letter h3 {
            font-family: var(--font-display);
            color: var(--primary);
            margin-bottom: 8px;
            font-size: 0.9rem;
            letter-spacing: 2px;
        }
        .love-letter p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* Easter Egg */
        #easter-egg {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(30px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fade-in 0.5s ease;
        }
        #easter-egg.show { display: flex; }
        @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

        .egg-content {
            background: linear-gradient(135deg, #1a0a1e, #0a0a0f);
            padding: 40px;
            border-radius: var(--radius);
            text-align: center;
            max-width: 90%;
            border: 1px solid var(--border-glow);
            box-shadow: 0 0 80px rgba(255,20,147,0.1);
        }
        .egg-content h2 {
            font-family: var(--font-display);
            font-size: 2rem;
            background: linear-gradient(135deg, #FF1493, #FFD700);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 12px;
        }
        .egg-content p { color: var(--text-secondary); margin: 12px 0 24px; }
        .egg-content button {
            padding: 12px 30px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
