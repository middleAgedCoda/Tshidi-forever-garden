function newLogic() {
    const available = LOGIC_PUZZLES.filter((_, i) => !state.logic.used.includes(i));
    if (available.length === 0) {
        state.logic.used = [];
        const fb = document.getElementById('logic-feedback');
        if (fb) {
            fb.textContent = '🎉 You solved all puzzles! Starting again!';
            fb.className = 'word-feedback success';
        }
        setTimeout(() => newLogic(), 2000);
        return;
    }
    
    const randomIndex = Math.floor(Math.random() * available.length);
    const puzzle = available[randomIndex];
    const originalIndex = LOGIC_PUZZLES.indexOf(puzzle);
    state.logic.used.push(originalIndex);
    state.logic.current = puzzle;
    
    document.getElementById('logic-puzzle').innerHTML = `
        <div>
            <div style="font-size:1.4rem; margin-bottom:12px;">🤔 Think carefully...</div>
            <div style="font-size:1.1rem;">${puzzle.question}</div>
        </div>
