    document.getElementById('logic-answer').focus();
    document.getElementById('logic-feedback').textContent = '';
    document.getElementById('logic-feedback').className = 'word-feedback';
}

function checkLogic() {
    const input = document.getElementById('logic-answer');
    const feedback = document.getElementById('logic-feedback');
    const answer = input.value.trim().toLowerCase();
    
    if (!answer) {
        feedback.textContent = '👀 Type something, my love!';
        feedback.className = 'word-feedback error';
        return;
    }
    
    if (answer === state.logic.current.answer.toLowerCase()) {
        const points = 50 + state.levels.logic * 10;
        state.scores.logic += points;
        state.scores.total += points;
        state.streak++;
        
        feedback.textContent = getRandomMessage('correct');
        feedback.className = 'word-feedback success';
        
        addFlower();
        checkLevelUp('logic');
        updateUI();
        saveState();
        
        setTimeout(() => newLogic(), 1500);
    } else {
        feedback.textContent = getRandomMessage('wrong');
        feedback.className = 'word-feedback error';
        state.streak = 0;
        updateUI();
        saveState();
    }
}

