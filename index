};

// =============================================
// STATE MANAGEMENT
// =============================================
function loadState() {
    try {
        const saved = localStorage.getItem('tshidiGardenUltimate');
        if (saved) {
            const parsed = JSON.parse(saved);
            Object.assign(state, parsed);
        }
    } catch(e) { console.log('No saved state'); }
}

function saveState() {
    try {
        localStorage.setItem('tshidiGardenUltimate', JSON.stringify(state));
    } catch(e) { console.log('Could not save'); }
}

// =============================================
// NAVIGATION
// =============================================
function navigateTo(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const target = document.getElementById(page);
    if (target) target.classList.add('active');
    
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector(`.nav-btn[data-page="${page}"]`);
    if (btn) btn.classList.add('active');
    
    if (page === 'word') initWordMode();
    if (page === 'numbers') initSudoku();
    if (page === 'logic') initLogicMode();
    if (page === 'adult') initAdultMode();
    if (page === 'garden') renderGarden();
}

// =============================================
// PROGRESSION SYSTEM
// =============================================
function checkLevelUp(mode) {
    const pointsPerLevel = 100;
    const currentScore = state.scores[mode];
    const currentLevel = state.levels[mode];
    const nextLevelThreshold = currentLevel * pointsPerLevel;
    
    state.progress[mode] = currentScore - (currentLevel - 1) * pointsPerLevel;
    
    if (currentScore >= nextLevelThreshold) {
        state.levels[mode]++;
        state.progress[mode] = 0;
        
        // Show level up celebration
        setTimeout(() => {
            const messages = {
                word: '📝 Word Master!',
                number: '🔢 Number Ninja!',
                logic: '🧠 Logic Legend!',
                adult: '🔥 Naughty Level Up!'
            };
            showCelebration(`Level ${state.levels[mode]} Unlocked! ${messages[mode] || '🎉'}`);
        }, 300);
        
        saveState();
        return true;
    }
    return false;
}

function updateProgressUI(mode) {
    const bar = document.getElementById(`${mode}-progress-bar`);
    const text = document.getElementById(`${mode}-progress-text`);
    if (bar && text) {
        const percentage = (state.progress[mode] / 100) * 100;
        bar.style.width = Math.min(percentage, 100) + '%';
        text.textContent = `${state.progress[mode]}/100`;
    }
}

// =============================================
// WORD MODE
// =============================================
function initWordMode() {
    document.getElementById('word-level').textContent = state.levels.word;
    document.getElementById('word-score').textContent = state.scores.word;
    document.getElementById('word-found').textContent = state.word.found;
    document.getElementById('word-total').textContent = WORDS.length;
    updateProgressUI('word');
    getNewWord();
}

function shuffleWord(word) {
    const arr = word.split('');
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr.join('');
}

function getNewWord() {
    const available = WORDS.filter((_, i) => !state.word.used.includes(i));
    if (available.length === 0) {
        state.word.used = [];
        const fb = document.getElementById('word-feedback');
        if (fb) {
            fb.textContent = '🎉 You found all words! Starting again!';
            fb.className = 'word-feedback success';
        }
        setTimeout(() => getNewWord(), 2000);
        return;
    }
    
    const randomIndex = Math.floor(Math.random() * available.length);
    const wordObj = available[randomIndex];
    const originalIndex = WORDS.indexOf(wordObj);
    state.word.used.push(originalIndex);
    state.word.current = wordObj;
    
    document.getElementById('word-scrambled').textContent = shuffleWord(wordObj.word);
    document.getElementById('word-hint').textContent = '💡 ' + wordObj.hint;
    document.getElementById('word-input').value = '';
    document.getElementById('word-input').focus();
    document.getElementById('word-feedback').textContent = '';
    document.getElementById('word-feedback').className = 'word-feedback';
}

function checkWord() {
    const input = document.getElementById('word-input');
    const feedback = document.getElementById('word-feedback');
    const answer = input.value.toUpperCase().trim();
    
    if (!answer) {
        feedback.textContent = '👀 Type something, love! I know you can!';
        feedback.className = 'word-feedback error';
        return;
    }
    
    if (answer === state.word.current.word) {
        const points = state.word.current.word.length * 10;
        state.scores.word += points;
        state.scores.total += points;
        state.word.found++;
        state.streak++;
        
        feedback.textContent = getRandomMessage('correct');
        feedback.className = 'word-feedback success';
        
        addFlower();
        checkLevelUp('word');
        updateUI();
        saveState();
        
        setTimeout(() => getNewWord(), 1500);
    } else {
        feedback.textContent = getRandomMessage('wrong');
        feedback.className = 'word-feedback error';
        state.streak = 0;
        updateUI();
        saveState();
    }
}

// =============================================
// SUDOKU MODE
// =============================================
function initSudoku() {
    document.getElementById('num-level').textContent = state.levels.number;
    newSudoku();
}

function generateSudoku() {
    const base = [
        [5,3,4,6,7,8,9,1,2],
        [6,7,2,1,9,5,3,4,8],
        [1,9,8,3,4,2,5,6,7],
        [8,5,9,7,6,1,4,2,3],
        [4,2,6,8,5,3,7,9,1],
        [7,1,3,9,2,4,8,5,6],
        [9,6,1,5,3,7,2,8,4],
        [2,8,7,4,1,9,6,3,5],
        [3,4,5,2,8,6,1,7,9]
    ];
    
    const puzzle = base.map(row => [...row]);
    let removed = 0;
    const difficulty = Math.min(35 + state.levels.number * 2, 55);
    while (removed < difficulty) {
        const row = Math.floor(Math.random() * 9);
        const col = Math.floor(Math.random() * 9);
        if (puzzle[row][col] !== 0) {
            puzzle[row][col] = 0;
            removed++;
        }
    }
    return { puzzle, solution: base };
}

function newSudoku() {
    const data = generateSudoku();
    state.sudoku.board = data.puzzle;
    state.sudoku.solution = data.solution;
    state.sudoku.selected = null;
    state.sudoku.errors = 0;
    renderSudoku();
    document.getElementById('sudoku-feedback').textContent = '';
    document.getElementById('sudoku-feedback').className = 'word-feedback';
}

function renderSudoku() {
    const board = document.getElementById('sudoku-board');
    board.innerHTML = '';
    
    for (let row = 0; row < 9; row++) {
        for (let col = 0; col < 9; col++) {
            const cell = document.createElement('div');
            cell.className = 'sudoku-cell';
            cell.dataset.row = row;
            cell.dataset.col = col;
            
            const value = state.sudoku.board[row][col];
            if (value !== 0) {
                cell.textContent = value;
                cell.classList.add('given');
            }
            
            cell.addEventListener('click', () => {
                if (state.sudoku.board[row][col] !== 0) return;
                document.querySelectorAll('.sudoku-cell.selected').forEach(el => el.classList.remove('selected'));
                state.sudoku.selected = { row, col };
                cell.classList.add('selected');
            });
            
            board.appendChild(cell);
        }
    }
}

function fillNumber(num) {
    const feedback = document.getElementById('sudoku-feedback');
    if (!state.sudoku.selected) {
        feedback.textContent = '👆 Tap an empty cell first, smarty pants!';
        feedback.className = 'word-feedback error';
        return;
    }
    
    const { row, col } = state.sudoku.selected;
    
    if (num === state.sudoku.solution[row][col]) {
        state.sudoku.board[row][col] = num;
        renderSudoku();
        feedback.textContent = getRandomMessage('correct');
        feedback.className = 'word-feedback success';
        state.sudoku.selected = null;
        
        if (isSudokuComplete()) {
            const points = 100 + state.levels.number * 20;
            state.scores.number += points;
            state.scores.total += points;
            feedback.textContent = `🎉 Mwari! You solved it! +${points} points!`;
            feedback.className = 'word-feedback success';
            addFlower();
            checkLevelUp('number');
            updateUI();
            saveState();
            setTimeout(() => newSudoku(), 3000);
        }
    } else {
        state.sudoku.errors++;
        feedback.textContent = getRandomMessage('wrong');
        feedback.className = 'word-feedback error';
        
        const cells = document.querySelectorAll('.sudoku-cell');
        const index = row * 9 + col;
        cells[index].classList.add('wrong');
        setTimeout(() => cells[index].classList.remove('wrong'), 1500);
    }
}

function clearCell() {
    if (!state.sudoku.selected) return;
    const { row, col } = state.sudoku.selected;
    if (state.sudoku.board[row][col] !== 0) {
        state.sudoku.board[row][col] = 0;
        renderSudoku();
        document.getElementById('sudoku-feedback').textContent = '🧹 Cell cleared!';
        document.getElementById('sudoku-feedback').className = 'word-feedback';
    }
}

function isSudokuComplete() {
    for (let row = 0; row < 9; row++) {
        for (let col = 0; col < 9; col++) {
            if (state.sudoku.board[row][col] === 0) return false;
        }
    }
    return true;
}

